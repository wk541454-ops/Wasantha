<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Ambient Shadow Under Blue Disc -->
    <path
        android:pathData="M50,7 A43,43 0 1,0 50,97 A43,43 0 1,0 50,7 Z"
        android:fillColor="#26000000" />

    <!-- 3D Blue Disc Base / Bevel Bottom Depth -->
    <path
        android:pathData="M50,8 A42,42 0 1,0 50,94 A42,42 0 1,0 50,8 Z"
        android:fillColor="#0D47A1" />

    <!-- Main Vibrant Blue Glossy Sphere / Circle Surface -->
    <path
        android:pathData="M50,6 A42,42 0 1,0 50,90 A42,42 0 1,0 50,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="25"
                android:startY="10"
                android:endX="75"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#3B82F6" />
                <item android:offset="0.35" android:color="#1D6FE5" />
                <item android:offset="0.7" android:color="#1557BF" />
                <item android:offset="1.0" android:color="#0F4299" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Glossy Specular Reflection on Blue Surface -->
    <path
        android:pathData="M22,18 C30,11 45,8 58,10 C70,12 80,18 84,26 C76,22 64,18 50,18 C36,18 27,21 22,18 Z"
        android:fillColor="#4DFFFFFF" />

    <!-- Plus Shadow onto Blue Disc (gives 3D floating / raised depth) -->
    <!-- Shadow Horizontal Bar -->
    <path
        android:pathData="M31,52 L69,52 A7,7 0 0,1 69,66 L31,66 A7,7 0 0,1 31,52 Z"
        android:fillColor="#33001F5C" />
    <!-- Shadow Vertical Bar -->
    <path
        android:pathData="M43,33 L43,71 A7,7 0 0,0 57,71 L57,33 A7,7 0 0,0 43,33 Z"
        android:fillColor="#33001F5C" />

    <!-- 3D White Plus Bottom Bevel / Extrusion Depth -->
    <!-- Extrusion Horizontal -->
    <path
        android:pathData="M30,47 L70,47 A7,7 0 0,1 70,61 L30,61 A7,7 0 0,1 30,47 Z"
        android:fillColor="#CBD5E1" />
    <!-- Extrusion Vertical -->
    <path
        android:pathData="M43,27 L43,67 A7,7 0 0,0 57,67 L57,27 A7,7 0 0,0 43,27 Z"
        android:fillColor="#CBD5E1" />

    <!-- 3D White Plus Main Rounded Face -->
    <!-- Horizontal Rounded Capsule -->
    <path
        android:pathData="M30,44 L70,44 A7,7 0 0,1 70,58 L30,58 A7,7 0 0,1 30,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="44"
                android:endX="50"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.8" android:color="#F8FAFC" />
                <item android:offset="1.0" android:color="#E2E8F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vertical Rounded Capsule -->
    <path
        android:pathData="M43,24 L43,64 A7,7 0 0,0 57,64 L57,24 A7,7 0 0,0 43,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="24"
                android:endX="57"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.8" android:color="#F8FAFC" />
                <item android:offset="1.0" android:color="#E2E8F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Plus Center Rounded Joint Smoother -->
    <path
        android:pathData="M43,44 L57,44 L57,58 L43,58 Z"
        android:fillColor="#FFFFFF" />

    <!-- Specular Highlight along Top Edges of White Plus -->
    <path
        android:pathData="M33,46 L67,46 A3,3 0 0,0 67,44 L33,44 A3,3 0 0,0 33,46 Z"
        android:fillColor="#80FFFFFF" />
    <path
        android:pathData="M46,26 L46,38 A2,2 0 0,0 48,38 L48,26 A2,2 0 0,0 46,26 Z"
        android:fillColor="#80FFFFFF" />

</vector>
